{
  "name": "api-client",
  "version": "1.0.0",
  "description": "HTTP client for the MyBasket backend: Bearer token, typed errors and JSON handling",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && bob build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "type": "commonjs",
  "peerDependencies": {
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.82.1",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__}/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "commonjs"
    ]
  }
}
