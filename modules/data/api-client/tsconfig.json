{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib/typescript",
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "declaration": true,
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "react-native"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"]
}
