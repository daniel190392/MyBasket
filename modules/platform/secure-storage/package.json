{
  "name": "secure-storage",
  "version": "1.0.0",
  "description": "Encrypted key-value storage backed by the platform secure store (Android Keystore)",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && bob build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "type": "commonjs",
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.0.0"
  },
  "codegenConfig": {
    "name": "SecureStorageSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.mybasket.securestorage"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "commonjs"
    ]
  }
}
