{
  "name": "feature-home",
  "version": "1.0.0",
  "description": "Home feature: product list, favorites and add product, with its own navigation",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && bob build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "type": "commonjs",
  "peerDependencies": {
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "react": ">=19.1.0",
    "react-native": ">=0.81.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-screens": ">=4.19.0",
    "ui-components": "^1.0.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.82.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.4",
    "jest": "^29.7.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-builder-bob": "^0.43.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "~4.25.2",
    "typescript": "^5.0.0",
    "ui-components": "^1.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!src/testing",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__,testing}/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "commonjs"
    ]
  }
}
