<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The encrypted session is useless on another device, because its Keystore key never leaves this one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.mybasket.securestorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.mybasket.securestorage.xml" />
    </device-transfer>
</data-extraction-rules>
